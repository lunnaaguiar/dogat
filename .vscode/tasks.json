{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar raylib",
      "type": "shell",
      "command": "gcc",
      "args": [
        "${workspaceFolder}/src/main.c",
        "${workspaceFolder}/src/player.c",
        "${workspaceFolder}/src/interactable.c",
        "${workspaceFolder}/src/mapa.c",
        "${workspaceFolder}/src/estados.c",
        "${workspaceFolder}/src/tempo.c",
        "${workspaceFolder}/src/score.c",
        // "${workspaceFolder}/fases.c",
        "-o", "${workspaceFolder}/Dogat.exe",
        "-I", "${workspaceFolder}/include",
        "-I", "${workspaceFolder}",
        "-I", "C:/raylib/include",
        "-L", "C:/raylib/lib",
        "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm",
      ],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}