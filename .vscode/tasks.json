{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar raylib",
      "type": "shell",
      "command": "gcc",
      "args": [
        "${workspaceFolder}/main.c",
        "${workspaceFolder}/player.c",
        "${workspaceFolder}/interactable.c",
        "${workspaceFolder}/mapa.c",
        "-o", "${workspaceFolder}/Dogat.exe",
        "-I", "C:/raylib/include",
        "-L", "C:/raylib/lib",
        "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm",
        "{workspaceFolder}/score.c",
      ],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}